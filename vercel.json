{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/PM2V/index.html" },
    { "source": "/index.html", "destination": "/PM2V/index.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/PM2V/:path*", "destination": "/PM2V/:path*" },
    { "source": "/:path*", "destination": "/PM2V/:path*" }
  ]
}
